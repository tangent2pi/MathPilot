{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mathpilot.dev/science-v3/teaching-artifact-math-derivation/v1",
  "title": "Math Derivation Teaching Artifact",
  "$description": "非权威教学推导。只描述可展示的数学步骤，不能承载掌握、错因、记忆或其他科学状态声明。",
  "type": "object",
  "required": ["schema", "steps"],
  "properties": {
    "schema": { "const": "mathpilot.teaching-artifact/math-derivation/v1" },
    "label": { "type": "string", "minLength": 1, "maxLength": 120 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["expression"],
        "properties": {
          "expression": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "note": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
