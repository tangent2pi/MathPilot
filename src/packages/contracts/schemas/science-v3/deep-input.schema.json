{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mathpilot.dev/science-v3/deep-input/v1",
  "title": "Dream Deep Gated Bundle",
  "type": "object",
  "required": [
    "schema_version", "compiler_version", "dream_run_id", "deep_window_id", "student_id",
    "expected_annotation_set_version", "gated_candidates", "current_annotations",
    "write_budget", "output_requirements", "history_is_untrusted_data"
  ],
  "properties": {
    "schema_version": { "$ref": "https://schemas.mathpilot.dev/science-v3/common/v1#/$defs/SchemaVersion" },
    "compiler_version": { "const": "deep-bundle-compiler-v1" },
    "dream_run_id": { "$ref": "https://schemas.mathpilot.dev/science-v3/common/v1#/$defs/DreamRunId" },
    "deep_window_id": { "type": "string", "pattern": "^dwin_[A-Za-z0-9]{8,}$" },
    "student_id": { "$ref": "https://schemas.mathpilot.dev/science-v3/common/v1#/$defs/StudentId" },
    "expected_annotation_set_version": { "type": "integer", "minimum": 0 },
    "gated_candidates": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "candidate_ref", "target_kind", "target_ref", "claim", "scope",
          "support_refs", "counter_refs", "contradictions", "actionability",
          "gate_policy_version", "gate_reasons"
        ],
        "properties": {
          "candidate_ref": { "type": "string", "pattern": "^rem-candidate://remc_[A-Za-z0-9]{8,}$" },
          "target_kind": { "enum": ["dimension", "error_cause", "student_trait"] },
          "target_ref": { "$ref": "https://schemas.mathpilot.dev/science-v3/common/v1#/$defs/OpaqueResourceRef" },
          "claim": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "scope": { "$ref": "https://schemas.mathpilot.dev/science-v3/common/v1#/$defs/StringMap" },
          "support_refs": { "$ref": "#/$defs/Refs" },
          "counter_refs": { "$ref": "#/$defs/Refs" },
          "contradictions": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 1000 }, "uniqueItems": true, "maxItems": 32 },
          "actionability": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "gate_policy_version": { "const": "deep-gate-v1" },
          "gate_reasons": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 }, "minItems": 1, "uniqueItems": true, "maxItems": 32 }
        },
        "additionalProperties": false
      }
    },
    "current_annotations": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["annotation_id", "target_kind", "target_ref", "claim", "scope", "support_refs", "counter_refs", "set_version"],
        "properties": {
          "annotation_id": { "$ref": "https://schemas.mathpilot.dev/science-v3/common/v1#/$defs/AnnotationId" },
          "target_kind": { "enum": ["dimension", "error_cause", "student_trait"] },
          "target_ref": { "$ref": "https://schemas.mathpilot.dev/science-v3/common/v1#/$defs/OpaqueResourceRef" },
          "claim": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "scope": { "$ref": "https://schemas.mathpilot.dev/science-v3/common/v1#/$defs/StringMap" },
          "support_refs": { "$ref": "#/$defs/Refs" },
          "counter_refs": { "$ref": "#/$defs/Refs" },
          "set_version": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "write_budget": {
      "type": "object",
      "required": ["maximum_operations", "maximum_additions", "maximum_supersessions", "maximum_reviews"],
      "properties": {
        "maximum_operations": { "type": "integer", "minimum": 1, "maximum": 50 },
        "maximum_additions": { "type": "integer", "minimum": 0, "maximum": 20 },
        "maximum_supersessions": { "type": "integer", "minimum": 0, "maximum": 20 },
        "maximum_reviews": { "type": "integer", "minimum": 0, "maximum": 20 }
      },
      "additionalProperties": false
    },
    "output_requirements": {
      "type": "object",
      "required": ["student_id", "dream_run_id", "expected_annotation_set_version", "policy_version"],
      "properties": {
        "student_id": { "$ref": "https://schemas.mathpilot.dev/science-v3/common/v1#/$defs/StudentId" },
        "dream_run_id": { "$ref": "https://schemas.mathpilot.dev/science-v3/common/v1#/$defs/DreamRunId" },
        "expected_annotation_set_version": { "type": "integer", "minimum": 0 },
        "policy_version": { "const": "deep-gate-v1" }
      },
      "additionalProperties": false
    },
    "history_is_untrusted_data": { "const": true }
  },
  "additionalProperties": false,
  "$defs": {
    "Refs": { "type": "array", "items": { "$ref": "https://schemas.mathpilot.dev/science-v3/common/v1#/$defs/EvidenceRef" }, "uniqueItems": true, "maxItems": 256 }
  }
}
