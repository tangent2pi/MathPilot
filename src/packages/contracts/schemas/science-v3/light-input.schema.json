{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mathpilot.dev/science-v3/light-input/v1",
  "title": "Dream Light Input Bundle",
  "type": "object",
  "required": [
    "schema_version", "compiler_version", "dream_run_id", "student_id",
    "question_session_id", "question_closure_ref", "frozen_context",
    "effective_attempts", "judgments", "observations", "error_evidence",
    "projection_refs", "source_manifest", "prior_annotations",
    "closed_at", "history_is_untrusted_data"
  ],
  "properties": {
    "schema_version": { "$ref": "https://schemas.mathpilot.dev/science-v3/common/v1#/$defs/SchemaVersion" },
    "compiler_version": { "const": "light-compiler-v1" },
    "dream_run_id": { "$ref": "https://schemas.mathpilot.dev/science-v3/common/v1#/$defs/DreamRunId" },
    "student_id": { "$ref": "https://schemas.mathpilot.dev/science-v3/common/v1#/$defs/StudentId" },
    "question_session_id": { "$ref": "https://schemas.mathpilot.dev/science-v3/common/v1#/$defs/QuestionSessionId" },
    "question_closure_ref": { "$ref": "https://schemas.mathpilot.dev/science-v3/common/v1#/$defs/OpaqueResourceRef" },
    "frozen_context": {
      "type": "object",
      "required": ["measurement_contract"],
      "properties": {
        "question_revision_id": { "$ref": "https://schemas.mathpilot.dev/science-v3/common/v1#/$defs/QuestionRevisionId" },
        "external_question_ref": { "$ref": "https://schemas.mathpilot.dev/science-v3/common/v1#/$defs/OpaqueResourceRef" },
        "measurement_contract": { "type": "object", "maxProperties": 32 },
        "learning_activity_ref": { "$ref": "https://schemas.mathpilot.dev/science-v3/common/v1#/$defs/OpaqueResourceRef" }
      },
      "additionalProperties": false,
      "oneOf": [
        { "required": ["question_revision_id"], "not": { "required": ["external_question_ref"] } },
        { "required": ["external_question_ref"], "not": { "required": ["question_revision_id"] } }
      ]
    },
    "effective_attempts": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["attempt_ref", "kind", "hint_level", "content_refs", "submitted_at"],
        "properties": {
          "attempt_ref": { "$ref": "https://schemas.mathpilot.dev/science-v3/common/v1#/$defs/EvidenceRef" },
          "kind": { "enum": ["answer", "probe", "correction", "explanation"] },
          "hint_level": { "type": "integer", "minimum": 0, "maximum": 9 },
          "content_refs": { "type": "array", "items": { "$ref": "https://schemas.mathpilot.dev/science-v3/common/v1#/$defs/EvidenceRef" }, "uniqueItems": true, "maxItems": 32 },
          "submitted_at": { "$ref": "https://schemas.mathpilot.dev/science-v3/common/v1#/$defs/ISODateTime" }
        },
        "additionalProperties": false
      }
    },
    "judgments": { "$ref": "#/$defs/FactSummaries" },
    "observations": { "$ref": "#/$defs/FactSummaries" },
    "error_evidence": { "$ref": "#/$defs/FactSummaries" },
    "projection_refs": {
      "type": "array", "items": { "$ref": "https://schemas.mathpilot.dev/science-v3/common/v1#/$defs/EvidenceRef" },
      "uniqueItems": true, "maxItems": 256
    },
    "source_manifest": {
      "type": "array", "items": { "$ref": "https://schemas.mathpilot.dev/science-v3/common/v1#/$defs/EvidenceRef" },
      "minItems": 1, "uniqueItems": true, "maxItems": 512
    },
    "prior_annotations": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["annotation_ref", "claim", "scope", "freshness"],
        "properties": {
          "annotation_ref": { "$ref": "https://schemas.mathpilot.dev/science-v3/common/v1#/$defs/EvidenceRef" },
          "claim": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "scope": { "$ref": "https://schemas.mathpilot.dev/science-v3/common/v1#/$defs/StringMap" },
          "freshness": { "enum": ["current", "stale"] }
        },
        "additionalProperties": false
      }
    },
    "closed_at": { "$ref": "https://schemas.mathpilot.dev/science-v3/common/v1#/$defs/ISODateTime" },
    "history_is_untrusted_data": { "const": true }
  },
  "additionalProperties": false,
  "$defs": {
    "FactSummaries": {
      "type": "array", "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["fact_ref", "summary"],
        "properties": {
          "fact_ref": { "$ref": "https://schemas.mathpilot.dev/science-v3/common/v1#/$defs/EvidenceRef" },
          "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "dimension_revision_ids": { "type": "array", "items": { "$ref": "https://schemas.mathpilot.dev/science-v3/common/v1#/$defs/DimensionRevisionId" }, "uniqueItems": true, "maxItems": 32 },
          "error_cause_revision_ids": { "type": "array", "items": { "$ref": "https://schemas.mathpilot.dev/science-v3/common/v1#/$defs/ErrorCauseRevisionId" }, "uniqueItems": true, "maxItems": 32 }
        },
        "additionalProperties": false
      }
    }
  }
}
