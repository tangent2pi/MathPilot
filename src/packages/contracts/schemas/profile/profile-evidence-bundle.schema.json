{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mathpilot.dev/profile/profile-evidence-bundle/v1",
  "title": "ProfileEvidenceBundle",
  "$description": "Dream Context Compiler 输出。written-by: profile-service；read-by: Dream/Profile Update Agent。不得包含 Teaching Agent 隐藏推理或模型历史；原始 Session 内容只以授权索引形式提供，按需展开。对齐设计文档 §11.3、实施规划 §7.3。",
  "type": "object",
  "required": [
    "bundle_id", "student_id", "window", "prior_snapshot_id",
    "records", "evidence_index", "permission_scope", "created_at"
  ],
  "properties": {
    "bundle_id": { "type": "string", "pattern": "^peb_[A-Za-z0-9]{8,}$" },
    "student_id": { "$ref": "https://schemas.mathpilot.dev/common/identity/v1#/$defs/StudentId" },
    "window": {
      "type": "object",
      "required": ["from", "to", "trigger"],
      "properties": {
        "from": { "$ref": "https://schemas.mathpilot.dev/common/identity/v1#/$defs/ISODateTime" },
        "to": { "$ref": "https://schemas.mathpilot.dev/common/identity/v1#/$defs/ISODateTime" },
        "trigger": {
          "type": "string",
          "enum": ["end_of_day", "session_count_threshold", "contradiction_detected", "teacher_request", "summary_overflow"]
        }
      },
      "additionalProperties": false
    },
    "prior_snapshot_id": {
      "anyOf": [
        { "$ref": "https://schemas.mathpilot.dev/common/identity/v1#/$defs/SnapshotId" },
        { "type": "null" }
      ],
      "description": "首次画像更新前无快照，显式 null"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["record_id", "session_id", "ser_id", "tss_id"],
        "properties": {
          "record_id": { "type": "string" },
          "session_id": { "$ref": "https://schemas.mathpilot.dev/common/identity/v1#/$defs/SessionId" },
          "ser_id": { "$ref": "https://schemas.mathpilot.dev/common/identity/v1#/$defs/ReportId" },
          "tss_id": { "$ref": "https://schemas.mathpilot.dev/common/identity/v1#/$defs/SummaryId" }
        },
        "additionalProperties": false
      }
    },
    "evidence_index": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref", "kind", "session_id", "expandable"],
        "properties": {
          "ref": { "type": "string" },
          "kind": { "type": "string", "enum": ["question", "answer", "chat_turn", "draft_segment", "artifact_interaction", "judgment", "observation", "teacher_correction"] },
          "session_id": { "$ref": "https://schemas.mathpilot.dev/common/identity/v1#/$defs/SessionId" },
          "expandable": { "type": "boolean", "description": "true 时 Dream 可按需拉取过滤后投影" }
        },
        "additionalProperties": false
      }
    },
    "dimension_relations": {
      "type": "array",
      "items": { "type": "string" },
      "description": "题目间迁移/难度/表征关系说明引用"
    },
    "permission_scope": {
      "type": "object",
      "required": ["tenant_id", "redactions"],
      "properties": {
        "tenant_id": { "$ref": "https://schemas.mathpilot.dev/common/identity/v1#/$defs/TenantId" },
        "redactions": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "truncation_notes": { "type": "array", "items": { "type": "string" } },
    "created_at": { "$ref": "https://schemas.mathpilot.dev/common/identity/v1#/$defs/ISODateTime" }
  },
  "additionalProperties": false
}
