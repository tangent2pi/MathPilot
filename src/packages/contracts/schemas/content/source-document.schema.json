{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mathpilot.dev/content/source-document/v1",
  "title": "SourceDocument & SourceFragment",
  "$description": "教师上传原件及其可引用最小片段。written-by: content-service；read-by: content-service、OCR provider、KTQ/ER session、血缘导出。原件字节在对象存储，元数据与哈希在 PostgreSQL。",
  "type": "object",
  "required": ["document_id", "tenant_id", "kind", "original_hash", "storage_ref", "uploaded_by", "uploaded_at"],
  "properties": {
    "document_id": { "type": "string", "pattern": "^doc_[A-Za-z0-9]{8,}$" },
    "tenant_id": { "$ref": "https://schemas.mathpilot.dev/common/identity/v1#/$defs/TenantId" },
    "kind": {
      "type": "string",
      "enum": ["pdf", "handout", "exercise_set", "error_summary", "web_page"]
    },
    "original_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "storage_ref": {
      "type": "string",
      "description": "对象存储键；禁止携带签名 URL"
    },
    "mime_type": { "type": "string" },
    "byte_size": { "type": "integer", "minimum": 1 },
    "uploaded_by": { "$ref": "https://schemas.mathpilot.dev/common/identity/v1#/$defs/UserId" },
    "uploaded_at": { "$ref": "https://schemas.mathpilot.dev/common/identity/v1#/$defs/ISODateTime" },
    "ocr_status": {
      "type": "string",
      "enum": ["pending", "parsed", "failed"],
      "default": "pending"
    },
    "ocr_provider_trace": { "$ref": "https://schemas.mathpilot.dev/providers/provider-trace/v1" },
    "fragments": {
      "type": "array",
      "items": { "$ref": "#/$defs/SourceFragment" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "SourceFragment": {
      "type": "object",
      "required": ["fragment_id", "document_id", "page_no", "fragment_type"],
      "properties": {
        "fragment_id": { "type": "string", "pattern": "^frg_[A-Za-z0-9]{8,}$" },
        "document_id": { "type": "string" },
        "page_no": { "type": "integer", "minimum": 1 },
        "fragment_type": {
          "type": "string",
          "enum": ["paragraph", "question_box", "image_region", "table", "heading"]
        },
        "bbox": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4,
          "description": "[x, y, w, h] 归一化坐标"
        },
        "text_markdown": { "type": "string" },
        "image_asset_ref": { "type": "string" },
        "content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    }
  }
}
