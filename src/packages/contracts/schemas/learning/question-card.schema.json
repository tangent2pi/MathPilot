{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agmath.dev/learning/question-card/v1",
  "title": "QuestionCard (agmath.question-card/v1)",
  "$description": "原生/ HTML 卡片统一语义。written-by: Teaching Agent / edu-agent；read-by: artifact-service、前端渲染器。HTML 卡片只能提交交互意图，不能自行判答。对齐设计文档 §5.4。",
  "type": "object",
  "required": ["schema", "artifact_id", "card_id", "type", "prompt", "response_policy", "evidence_policy"],
  "properties": {
    "schema": { "const": "agmath.question-card/v1" },
    "artifact_id": { "$ref": "https://schemas.agmath.dev/common/identity/v1#/$defs/ArtifactId" },
    "card_id": { "type": "string", "pattern": "^card_[A-Za-z0-9]+$" },
    "type": {
      "type": "string",
      "enum": ["single_choice", "multiple_choice", "fill_blank", "true_false"]
    },
    "prompt": { "type": "string", "minLength": 1 },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "content"],
        "properties": {
          "id": { "type": "string" },
          "content": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "blanks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "expected_format": { "type": "string", "enum": ["number", "expression", "text"] }
        },
        "additionalProperties": false
      },
      "description": "fill_blank 时使用，支持多个命名空格"
    },
    "response_policy": {
      "type": "object",
      "required": ["required", "allow_skip", "allow_free_text_without_answer"],
      "properties": {
        "required": { "const": false },
        "allow_skip": { "const": true },
        "allow_free_text_without_answer": { "const": true }
      },
      "additionalProperties": false
    },
    "evidence_policy": {
      "type": "string",
      "enum": ["teaching_only", "eligible_if_independent"],
      "default": "teaching_only"
    },
    "source_refs": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
