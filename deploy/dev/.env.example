# 数据库
POSTGRES_USER=mathpilot
POSTGRES_PASSWORD=mathpilot-dev-only
POSTGRES_DB=mathpilot
APP_DB_PASSWORD=mathpilot-app-dev-only
PGPORT=5432
AGENT_DB_MASTER_SECRET=mathpilot-agent-dev-master-change-me
# home 正式切换使用独立新卷；原 mathpilot_pgdata 不删除、不复用。
POSTGRES_VOLUME=mathpilot_pgdata_next

# 对外仅暴露 Web；生产部署建议绑定到反向代理可达的专用地址。
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080

# Better Auth（生产必须替换 secret、启用 secure cookie，并使用 HTTPS URL）
BETTER_AUTH_URL=http://localhost:8080
BETTER_AUTH_SECRET=mathpilot-dev-secret-change-me-at-least-32-characters
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
BETTER_AUTH_SECURE_COOKIES=false
BETTER_AUTH_IP_ADDRESS_HEADERS=x-real-ip
BETTER_AUTH_STUDENT_EMAIL=student@mathpilot.local
BETTER_AUTH_STUDENT_PASSWORD=MathPilotStudent123!
BETTER_AUTH_TEACHER_EMAIL=teacher@mathpilot.local
BETTER_AUTH_TEACHER_PASSWORD=MathPilotTeacher123!

# assistant-ui + Pi 对话链路（网关与 runtime 必须使用同一个 32+ 字符 secret）
PI_GATEWAY_SECRET=mathpilot-pi-gateway-dev-change-me-at-least-32-characters
PI_MODEL_API_BASE=https://api.deepseek.com
PI_MODEL_API_KEY=
PI_MODEL_ID=deepseek-v4-flash-vision-exp
PI_CHAT_RUNTIME_VOLUME=mathpilot_pi_chat_runtime

# MinIO 仅在 Compose 内网提供对象存储，不映射宿主端口。
MINIO_ROOT_USER=mathpilot-minio
MINIO_ROOT_PASSWORD=mathpilot-minio-dev-change-me
MINIO_BUCKET=mathpilot-workspaces
MINIO_VOLUME=mathpilot_minio_data

# ── 模型供应商（密钥只注入 agent-runtime（Pi 宿主），绝不入库、不进沙箱/前端） ──
# 模型调用统一经 agent-runtime：pi-ai → scnet OpenAI 兼容端点（providers/model 客户端）
MODEL_API_BASE=https://api.scnet.cn/api/llm/v1
MODEL_API_KEY=
MODEL_ID_MAIN=Qwen3.8-Max
MODEL_ID_AUX=DeepSeek-V4-Flash-0731
# 可选联网搜索：Qwen-MM-Plugins/search（至少配置一个；auto 顺序 Serper → Tavily → Exa）
SERPER_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
QWEN_MM_SEARCH_BACKEND=auto

# ── OCR 供应商（密钥只注入 content（宿主侧），providers/ocr 实现） ──
OCR_API_BASE=https://paddleocr.aistudio-app.com
OCR_API_TOKEN=
OCR_MODEL=PaddleOCR-VL-1.6
