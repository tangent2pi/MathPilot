# 数据库
POSTGRES_USER=mathpilot
POSTGRES_PASSWORD=mathpilot-dev-only
POSTGRES_DB=mathpilot
APP_DB_PASSWORD=mathpilot-app-dev-only
PGPORT=5432
AGENT_DB_MASTER_SECRET=mathpilot-agent-dev-master-change-me
# home 正式切换使用独立新卷；原 mathpilot_pgdata 不删除、不复用。
POSTGRES_VOLUME=mathpilot_pgdata_next
DEFAULT_TENANT_ID=tnt_dev00001
DEFAULT_TEACHER_USER_ID=usr_teacher01

# 对外仅暴露 Web；生产部署建议绑定到反向代理可达的专用地址。
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080

# Better Auth（生产必须替换 secret、启用 secure cookie，并使用 HTTPS URL）。
# 证据签名 secret 必须独立；只有显式 development profile 才允许下列开发默认值。
MATHPILOT_ENVIRONMENT=development
BETTER_AUTH_URL=http://localhost:8080
BETTER_AUTH_SECRET=mathpilot-dev-secret-change-me-at-least-32-characters
LEARNING_EVIDENCE_SECRET=mathpilot-dev-evidence-secret-change-me-at-least-32-characters
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
BETTER_AUTH_SECURE_COOKIES=false
BETTER_AUTH_IP_ADDRESS_HEADERS=x-real-ip
BETTER_AUTH_STUDENT_EMAIL=student@mathpilot.local
BETTER_AUTH_STUDENT_PASSWORD=MathPilotStudent123!
BETTER_AUTH_TEACHER_EMAIL=teacher@mathpilot.local
BETTER_AUTH_TEACHER_PASSWORD=MathPilotTeacher123!

# 内部服务身份。每条调用边使用独立、可轮换的 keyring；这些是公开开发值，
# production 会拒绝。生产 keyring 使用 32–64 随机字节的 base64url 值。
MATHPILOT_INTERNAL_REPLAY_MODE=memory-single-replica
MATHPILOT_INTERNAL_API_TO_CONTENT_KEYRING={"active":"dev-v1","keys":{"dev-v1":"moGdXNI-sjfx9clK0dYsYPDi_HcXFrWvuI5yMif7AN4"}}
MATHPILOT_INTERNAL_API_TO_STORAGE_KEYRING={"active":"dev-v1","keys":{"dev-v1":"u338eYqqB8TrqFHD5Oavw0dyO7EHTtbrWAST7Gw3ASE"}}
MATHPILOT_INTERNAL_CONTENT_TO_PI_KEYRING={"active":"dev-v1","keys":{"dev-v1":"k9C-0Z8asyrdkyN0VsRNfZAxFUOz-G_oxIPmjNrfXXU"}}
MATHPILOT_INTERNAL_PI_TO_CONTENT_KEYRING={"active":"dev-v1","keys":{"dev-v1":"C3qgQB2YxpFkyRuskfi6DTFjrM41bJ52WXg3jpPojKk"}}
MATHPILOT_INTERNAL_PI_TO_STORAGE_KEYRING={"active":"dev-v1","keys":{"dev-v1":"He6fL8P69SDCETgMmwExof60jAeYsfVUbC6XR2r-QY4"}}
MATHPILOT_INTERNAL_LEARNING_TO_STORAGE_KEYRING={"active":"dev-v1","keys":{"dev-v1":"EGkdPeF_yU7GTNlyBPtacgTqTtvkuPT41VqcSYWI8nU"}}
PI_MODEL_API_BASE=https://api.deepseek.com
PI_MODEL_API_KEY=
PI_MODEL_ID_MAIN=deepseek-v4-flash-vision-exp
PI_MODEL_ID_AUX=deepseek-v4-flash-vision-exp
PI_CHAT_RUNTIME_VOLUME=mathpilot_pi_chat_runtime

# MinIO 的管理端点只给 storage-next；浏览器使用单独的、部署可达的
# MINIO_PUBLIC_ENDPOINT。开发默认 localhost，生产设置为
# https://mathpilot.tangentpi.com（或你的反向代理地址）。
MINIO_ROOT_USER=mathpilot-minio
MINIO_ROOT_PASSWORD=mathpilot-minio-dev-change-me
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_CORS_ALLOWED_ORIGINS=http://localhost:8080
MINIO_BIND_ADDRESS=127.0.0.1
MINIO_REGION=us-east-1
MINIO_VOLUME=mathpilot_minio_data

# 可选联网搜索：Qwen-MM-Plugins/search（至少配置一个；auto 顺序 Serper → Tavily → Exa）
SERPER_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
QWEN_MM_SEARCH_BACKEND=auto

# ── OCR 供应商（compose 只注入需要 OCR 的宿主，不进浏览器或 Search/Core 沙箱） ──
OCR_API_BASE=https://paddleocr.aistudio-app.com
OCR_API_TOKEN=
OCR_MODEL=PaddleOCR-VL-1.6
