+type WorkspaceAttachmentDetails = {
+  id: string;
+  originalName: string;
+  workspacePath: string;
+  mimeType: string;
+};
+
+const workspaceAttachmentsOf = (
+  message: PiCustomMessage,
+): MessageAttachment[] | undefined => {
+  if (message.customType !== "mathpilot.turn-attachments" || message.display) {
+    return undefined;
+  }
+  const details = message.details as { attachments?: unknown } | undefined;
+  if (!Array.isArray(details?.attachments)) return undefined;
+
+  const files = details.attachments.filter(
+    (value): value is WorkspaceAttachmentDetails => {
+      if (typeof value !== "object" || value === null) return false;
+      const file = value as Partial<WorkspaceAttachmentDetails>;
+      return (
+        typeof file.id === "string" &&
+        typeof file.originalName === "string" &&
+        typeof file.workspacePath === "string" &&
+        file.workspacePath.startsWith("input/original/") &&
+        typeof file.mimeType === "string" &&
+        !file.mimeType.toLowerCase().startsWith("image/")
+      );
+    },
+  );
+  if (files.length === 0) return undefined;
+
+  return files.map((file) => ({
+    id: file.id,
+    type: "document",
+    name: file.originalName,
+    contentType: file.mimeType,
+    status: { type: "complete" },
+    content: [
+      {
+        type: "file",
+        data: file.workspacePath,
+        sourceType: "id",
+        mimeType: file.mimeType,
+        filename: file.originalName,
+      },
+    ],
+  }));
+};
